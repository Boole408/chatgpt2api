# 管理员密钥，调用 API 与登录后台使用
CHATGPT2API_AUTH_KEY=

# Docker compose 主机端口、Go 数据目录及 Go 镜像
CHATGPT2API_HOST_PORT=3000
CHATGPT2API_DATA_DIR=./data-go
# 留空时从当前仓库构建；使用发布镜像时填写完整的 Go 镜像引用
CHATGPT2API_IMAGE=
# 仅用于 Compose，避免直接连接旧版 DATABASE_URL 所指的数据库
CHATGPT2API_DATABASE_URL=

# 服务监听端口，默认 3000（Docker 部署无需设置）
PORT=3000

# 服务监听地址，留空监听全部网卡；设为 127.0.0.1 则仅本机可访问（端口仍由 PORT 决定）
# 直接运行二进制或 docker run -e 时生效；docker compose 不会透传，只允许本机访问请改用
# 端口映射 127.0.0.1:3000:80，在容器内设置本变量会导致容器外无法访问
BIND_ADDR=

# 直接运行 Go 时的数据目录和数据库连接
CHATGPT2API_STORAGE_DIR=./data-go
# 数据库连接留空使用存储目录下的 chatgpt2api.db
# PostgreSQL: postgresql://user:password@host:5432/chatgpt2api
# MySQL: mysql://user:password@host:3306/chatgpt2api
DATABASE_URL=
